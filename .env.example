# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Leave SHOPIFY_STORE_DOMAIN empty to run the site on the built-in preview catalog.

# e.g. pampera.myshopify.com (the .myshopify.com domain, not pamperagolf.com)
SHOPIFY_STORE_DOMAIN=
# Headless channel → Storefront API → public access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Handle of the collection shown on the home page and /shop
SHOPIFY_COLLECTION_HANDLE=la-pampa
# Shopify Admin → Settings → Notifications → Webhooks → signing secret
SHOPIFY_WEBHOOK_SECRET=
# Public site URL, used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://pamperagolf.com
# Instagram API long-lived access token for @pamperagolf (see docs/INSTAGRAM_SETUP.md).
# Leave empty to show the site's own photography in the Instagram strip instead.
INSTAGRAM_ACCESS_TOKEN=
